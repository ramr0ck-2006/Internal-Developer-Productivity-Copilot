(()=>{"use strict";const e=()=>{const e=document.documentElement.getAttribute("data-bs-theme")==="dark";document.querySelectorAll("img[data-theme-src-dark]").forEach(t=>{const n=e?t.getAttribute("data-theme-src-dark"):t.getAttribute("data-theme-src-light");n&&t.getAttribute("src")!==n&&t.setAttribute("src",n)})};e(),new MutationObserver(e).observe(document.documentElement,{attributes:!0,attributeFilter:["data-bs-theme"]})})()